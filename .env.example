# PayPal — get these from developer.paypal.com (a Sandbox app for testing,
# a Live app for production). PAYPAL_SECRET must stay server-only.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# For production: https://api-m.paypal.com

# Same PayPal client ID, exposed to the browser bundle via the VITE_ prefix.
VITE_PAYPAL_CLIENT_ID=

# Supabase — Project Settings > API. SUPABASE_SERVICE_ROLE_KEY must stay
# server-only: it bypasses Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
