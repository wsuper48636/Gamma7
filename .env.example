# PayPal — get these from developer.paypal.com (a Sandbox app for testing,
# a Live app for production). PAYPAL_SECRET must stay server-only.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# For production: https://api-m.paypal.com

# Same PayPal client ID, exposed to the browser bundle via the VITE_ prefix.
VITE_PAYPAL_CLIENT_ID=

# Supabase — Project Settings > API. SUPABASE_SERVICE_ROLE_KEY must stay
# server-only: it bypasses Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) — order confirmation emails. Without these set, the
# checkout still works, it just silently skips sending email.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (or their sandbox
# address for testing, which can only email your own account's address).
ORDER_FROM_EMAIL=
# Where new-order notifications go. Optional — omit to only email the
# customer.
MERCHANT_NOTIFICATION_EMAIL=
# Reply-To on the customer's confirmation email — a real inbox you check
# (e.g. via Namecheap email forwarding), so replies don't bounce. Matches
# the contact address shown on the site.
SUPPORT_EMAIL=support@gamma7.online
